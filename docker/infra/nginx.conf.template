# Balanceador de la Práctica 5. Para cambiar de algoritmo, cambia la línea marcada y reinicia el balanceador
# (este archivo es una plantilla: la imagen la convierte en configuración al arrancar, así que `nginx -s reload` no basta):
#   docker compose -f docker/compose.yml restart balanceador
# Las direcciones de los nodos y de los Reverb llegan por variables (docker/.env), no se editan aquí.
# "resolve" hace que Nginx vuelva a consultar el DNS de Docker: si un contenedor se recrea con otra IP,
# o aún no existe cuando Nginx arranca, el balanceador lo encuentra sin reiniciarse.
resolver 127.0.0.11 valid=5s ipv6=off;

upstream trackeat {
    zone trackeat 64k;
    least_conn;        # ip_hash;  o bórrala para turno rotatorio
    server ${NODO1_ADDR} resolve max_fails=2 fail_timeout=10s;
    server ${NODO2_ADDR} resolve max_fails=2 fail_timeout=10s;
}

# Un Reverb por nodo; entre ellos se sincronizan con Redis, así que una pantalla puede conectarse a cualquiera.
upstream reverb {
    zone reverb 64k;
    least_conn;
    server ${REVERB1_ADDR} resolve max_fails=2 fail_timeout=10s;
    server ${REVERB2_ADDR} resolve max_fails=2 fail_timeout=10s;
}

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

map "${URL_PUBLICA}" $trackeat_wss_origin {
    "~^https://(?<trackeat_public_authority>[^/]+)$" "wss://$trackeat_public_authority";
    default "";
}

map $upstream_http_referrer_policy $trackeat_referrer_policy {
    "no-referrer" no-referrer;
    default strict-origin-when-cross-origin;
}

map $uri $trackeat_app_node {
    ~^/app "";
    default $upstream_addr;
}

server {
    listen 80 default_server;
    server_name _;

    # El origen lo fija el despliegue. Conserva la ruta y los parámetros de la petición.
    return 301 ${URL_PUBLICA}$request_uri;
}

server {
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate /etc/nginx/trackeat-tls/server.pem;
    ssl_certificate_key /etc/nginx/trackeat-tls/server-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Content-Security-Policy "default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' https://fonts.bunny.net; font-src 'self' https://fonts.bunny.net; img-src 'self' data: blob:; connect-src 'self' $trackeat_wss_origin; frame-src https://challenges.cloudflare.com; worker-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'" always;
    add_header Strict-Transport-Security "max-age=300" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy $trackeat_referrer_policy always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    # Se conserva el diagnóstico del nodo de Laravel sin alterar la herencia de las cabeceras.
    add_header X-Nodo $trackeat_app_node always;

    # El navegador pide el icono en cada recarga y se come un turno.
    location = /favicon.ico { return 204; }

    # WebSockets de Reverb (pantalla de cocina). Si un Reverb cae, el cliente se reconecta y Nginx lo manda al otro.
    location /app {
        proxy_pass http://reverb;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $http_host;
        proxy_next_upstream error timeout;
        proxy_connect_timeout 2s;
        proxy_read_timeout 3600s;
    }

    location / {
        proxy_pass http://trackeat;

        proxy_set_header Host              $http_host;   # con el puerto
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host  "";
        proxy_set_header X-Forwarded-Port  "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_hide_header Referrer-Policy;

        proxy_next_upstream error timeout http_502 http_503 http_504;
        # Si un nodo se apaga, su IP deja de contestar; sin esto Nginx espera 60 s antes de probar el otro.
        proxy_connect_timeout 2s;

    }
}
