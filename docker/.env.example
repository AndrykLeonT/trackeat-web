# Variables de los composes de docker/. Copia este archivo como docker/.env (no se sube a Git).
#
# MODO UNA PC: los valores por omisión usan localhost. Antes de iniciar, genera el certificado
# y la clave en docker/infra/tls según docs/evidencias/02-nginx-https.md.
#
# MODO VARIAS PCs: usa el mismo docker/.env, con las IPs reales, en TODAS las PCs, y pasa
#   --env-file docker/.env a cada `docker compose`. Descomenta y ajusta lo siguiente.

# Escuchar en todas las interfaces (por omisión solo 127.0.0.1). Necesario para que otras PCs entren.
# Hay que abrir en el firewall de Windows: 8080, 8443, 5433, 6380, 8001, 8002, 8091, 8092 según la PC.
#ESCUCHA=0.0.0.0

# ---- Dónde está la infraestructura (IP de la PC de infraestructura) ----
#DB_HOST=192.168.1.10
#DB_PORT=5433
#REDIS_HOST=192.168.1.10
#REDIS_PORT=6380

# ---- Dónde están los nodos, tal como los ve el balanceador (IP de cada PC : puerto publicado) ----
#NODO1_ADDR=192.168.1.11:8001
#NODO2_ADDR=192.168.1.12:8002
#REVERB1_ADDR=192.168.1.11:8091
#REVERB2_ADDR=192.168.1.12:8092

# ---- HTTPS del balanceador ----
# URL_PUBLICA es el origen HTTPS sin barra final. El nombre o IP debe figurar en el certificado.
#URL_PUBLICA=https://localhost:8443
# En modo LAN, por ejemplo: URL_PUBLICA=https://192.168.1.10:8443
#HTTP_PUERTO_PUBLICADO=8080
#HTTPS_PUERTO_PUBLICADO=8443
# Directorio que contiene server.pem y server-key.pem, relativo al compose de infraestructura.
#TLS_DIR=./tls

# IP de la PC del balanceador; los nodos solo creen en X-Forwarded-* de ese proxy.
#TRUSTED_PROXIES=192.168.1.10

# ---- Contraseñas (cámbialas fuera de una demo) ----
#DB_PASSWORD=trackeat
#REDIS_PASSWORD=trackeat-redis

# ---- Puertos con que se publican la BD y Redis en la PC de infraestructura ----
# (distintos de 5432/6379 para no chocar con un PostgreSQL o Redis local).
#DB_PUERTO_PUBLICADO=5433
#REDIS_PUERTO_PUBLICADO=6380

# ---- Captcha de Cloudflare Turnstile (registro y login) ----
# Por omisión se usan las llaves de PRUEBA públicas de Cloudflare: la del sitio (3x...FF) obliga a
# resolver el reto ("Verifica que eres humano") y la secreta (1x...AA) siempre acepta.
# Llaves reales: panel de Cloudflare > Turnstile > Add widget > dominio del sitio; copia "Site Key" y "Secret Key".
# Para la demo de rechazo usa el secreto de prueba que siempre falla: 2x0000000000000000000000000000000AA
#TURNSTILE_SITE_KEY=3x00000000000000000000FF
#TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
