# Variables de los composes de docker/. Copia este archivo como docker/.env (no se sube a Git).
#
# MODO UNA PC: no hace falta ningún .env; los valores por omisión funcionan tal cual.
#
# MODO VARIAS PCs: usa el mismo docker/.env, con las IPs reales, en TODAS las PCs, y pasa
#   --env-file docker/.env a cada `docker compose`. Descomenta y ajusta lo siguiente.

# Escuchar en todas las interfaces (por omisión solo 127.0.0.1). Necesario para que otras PCs entren.
# Hay que abrir en el firewall de Windows: 8080, 5433, 6380, 8001, 8002, 8091, 8092 según la PC.
#ESCUCHA=0.0.0.0

# ---- Dónde está la infraestructura (IP de la PC de infraestructura) ----
#DB_HOST=192.168.1.10
#DB_PORT=5433
#REDIS_HOST=192.168.1.10
#REDIS_PORT=6380

# ---- Dónde están los nodos, tal como los ve el balanceador (IP de cada PC : puerto publicado) ----
#NODO1_ADDR=192.168.1.11:8001
#NODO2_ADDR=192.168.1.12:8002
#REVERB1_ADDR=192.168.1.11:8091
#REVERB2_ADDR=192.168.1.12:8092

# ---- Dirección con la que el navegador entra (la del balanceador) ----
#URL_PUBLICA=http://192.168.1.10:8080
# IP de la PC del balanceador; los nodos solo creen en X-Forwarded-* de ese proxy.
#TRUSTED_PROXIES=192.168.1.10

# ---- Contraseñas (cámbialas fuera de una demo) ----
#DB_PASSWORD=trackeat
#REDIS_PASSWORD=trackeat-redis

# ---- Puertos con que se publican la BD y Redis en la PC de infraestructura ----
# (distintos de 5432/6379 para no chocar con un PostgreSQL o Redis local).
#DB_PUERTO_PUBLICADO=5433
#REDIS_PUERTO_PUBLICADO=6380
